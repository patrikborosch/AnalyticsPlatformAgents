!output/artifacts/
output/artifacts/*
!output/artifacts/notebooks/
!output/artifacts/pipelines/
!output/artifacts/warehouse/
output/artifacts/notebooks/*
output/artifacts/pipelines/*
output/artifacts/warehouse/*
!output/artifacts/**/.gitkeep

# Office files (may contain author metadata)
*.docx
*.pptx
*.xlsx

# Environment / secrets
.env
.env.*
*.env
.secrets
*.pem
*.key
